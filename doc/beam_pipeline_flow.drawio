        <mxCell id="head1" value="② 插值得到 C1~C14" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
