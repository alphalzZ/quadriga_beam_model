        <mxCell id="head0" value="① 阵列排布训练" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
