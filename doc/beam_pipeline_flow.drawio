        </mxCell>
        <mxCell id="head2" value="③ 插值准确性检验" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="112" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a0" value="&lt;b&gt;78 个实测方向图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;只有归一化功率&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="75" y="180" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;假设三角栅格阵列&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;间距 · 旋转 · 加权 · 阵元方向图&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="75" y="272" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;搜索阵子排布&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;训练 / 留出检验&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="75" y="364" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;选定 502 阵子椭圆排布&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;主瓣留出误差 0.05 dB&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="75" y="456" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;逐点残差校准&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;物理基准 + 残差 = 实测&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="75" y="548" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;阵子排布 + 校准表&lt;/b&gt;" style="fontFamily=Helvetica;shape=document;boundedLbl=1;size=0.2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="75" y="640" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="b0" value="&lt;b&gt;14 个目标指向&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;C1~C14&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="180" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;取 4 个邻居波束&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;双线性权重&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="272" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;旋转到目标指向&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;整张功率图对齐主瓣&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="364" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;线性功率加权求和&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="456" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;加上假设相位&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;来自阵子排布&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
