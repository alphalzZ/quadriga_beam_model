        <mxCell id="title" value="从实测方向图到 C1~C14 波束" style="fontFamily=Helvetica;text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
